PORT=2567
NODE_ENV=development
ALLOW_DEV_TOKENS=true

# Auth0 tenant (issuer is https://$AUTH0_DOMAIN/)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://tag.phaser.game

# Colyseus 0.18 matchmake already reflects the request Origin.
# Keep this as documentation for a later allowlist if you tighten CORS.
CORS_ORIGIN=http://localhost:5173,https://phaser-colyseus-tag.vercel.app,https://*.vercel.app
