# Copy the values you need into client/.env and server/.env
# (or export them in your shell). Never commit secrets.

# --- Auth0 (public SPA values) ---
# AUTH0_CLI_AUTH_MODE=env
# AUTH0_DOMAIN copied from AUTH0_CLI_DOMAIN
# AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET are the *CLI machine* app, not the game SPA.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://tag.phaser.game
VITE_AUTH0_CONNECTION=email
VITE_COLYSEUS_URL=http://localhost:2567

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://tag.phaser.game
ALLOW_DEV_TOKENS=true
CORS_ORIGIN=http://localhost:5173
PORT=2567
